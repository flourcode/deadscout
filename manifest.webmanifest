{"name":"Driftnaut Radio","short_name":"Driftnaut","description":"A live lo-fi station aboard a little pixel spaceship. Leave it on while you work, read, or wind down, and watch life aboard the Halcyon.","start_url":"index.html","scope":"./","display":"standalone","background_color":"#050508","theme_color":"#06060a","icons":[{"src":"icon-192.png","sizes":"192x192","type":"image/png"},{"src":"icon-512.png","sizes":"512x512","type":"image/png"},{"src":"icon-512.png","sizes":"512x512","type":"image/png","purpose":"maskable"}]}